# env.list.sample — DFO Next.js app environment variables
# Never commit env.list. Copy this file to env.list and fill in.

### DC services (required) ###

# API key for the Data Commons base API. SERVER-SIDE ONLY — never exposed to the browser.
DC_API_KEY=
# API key for Google Maps / Places APIs.
MAPS_API_KEY=
# Output directory for generated CSV files (absolute path or gs://<BUCKET>/<FOLDER>).
OUTPUT_DIR=
# Input directory containing files to be processed (absolute path or gs://<BUCKET>/<FOLDER>).
INPUT_DIR=

### DFO Next.js app ###

# Port the Next.js app listens on inside the container.
DFO_PORT=3000
# Base URL for the DC mixer API, used server-side only.
# Default (in-container): http://127.0.0.1:8081/v2
# Override only when running `next dev` on the host against a remote DC instance.
# DC_API_BASE_URL=http://127.0.0.1:8081/v2

# Set to true/1 to point the search prototype's transport at the live Search API
# instead of local fixtures. Client-exposed (NEXT_PUBLIC_*) — no secrets here.
# NEXT_PUBLIC_USE_SEARCH_API=true
# Override the Search API base URL the browser talks to. Defaults to same-origin.
# NEXT_PUBLIC_SEARCH_API_BASE=http://127.0.0.1:8083
# Website origin (or a local dfo-apis engine) for the /api/search and
# /api/datasets rewrites. Needed only with DEBUG=true, where `next dev` reads
# next.config.mjs at start. The baked image carries the value it was built with.
# DFO_SITE_ORIGIN=http://127.0.0.1:8083

### Optional ###

# Set to true to run Next.js in dev mode (hot reload) inside the container.
DEBUG=false
