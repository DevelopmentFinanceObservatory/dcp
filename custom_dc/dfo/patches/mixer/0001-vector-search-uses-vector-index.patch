 	params := map[string]interface{}{
 		"embeddings":      embeddings,
 		"limit":           limit,
+		"candidate_limit": limit * vectorSearchCandidateFactor,
 		"embedding_label": embeddingLabel,
 	}
 	var nodeTypeCondition string
